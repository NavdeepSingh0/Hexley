# Copy to .env and fill in locally. Never commit .env.
# This file holds variable NAMES and non-secret defaults only.

# --- Local Ollama (OpenAI-compatible endpoint) ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- NVIDIA hosted models (build.nvidia.com), OpenAI-compatible ---
# Put your key in .env (git-ignored), never in this file or in chat.
NVIDIA_API_KEY=
# Confirm the base URL against the code sample on your model's build.nvidia.com page.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model ids derived from the build.nvidia.com page URLs. Confirm each against the "model" field
# in that page's code sample before relying on it.
NEMOTRON_BOLT_MODEL=nvidia/nemotron-3.5-bolt-e4b
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Free tier is reported as about 40 requests per minute. The harness throttles below that.
NVIDIA_MAX_RPM=30

# --- Sentinel runtime (used from M1 onwards) ---
SENTINEL_AGENT_MODEL=
SENTINEL_API_TOKEN=
SENTINEL_SIGNING_KEY_PATH=
