# Copy to .env and fill in locally. Never commit .env.
# Key NAMES only in this file.

# Local Ollama endpoint (OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1
SENTINEL_AGENT_MODEL=

# Static bearer token for the console and REST API
SENTINEL_API_TOKEN=

# Path to the Ed25519 signing key for the audit log and session tokens (generated, git-ignored)
SENTINEL_SIGNING_KEY_PATH=
