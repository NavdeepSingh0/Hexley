{
  "manifest_version": 3,
  "name": "Hexley",
  "version": "0.1.0",
  "description": "Shows Hexley's mascot on claude.ai and chatgpt.com, reacting to real gateway decisions. Lets you approve or deny held actions from the browser.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg",
    "default_title": "Hexley"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": ["storage"],

  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "overlay.js", "sentinel-mascot.js", "icon.svg"],
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"]
    }
  ]
}

